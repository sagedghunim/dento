# Copy to .env for local work. scripts\pg.ps1 init writes a real one for you.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=hamada
PGUSER=hamada
PGPASSWORD=change-me
# Optional. Production uses Redis for sessions, rate limits and the live queue versions.
# REDIS_URL=redis://redis:6379/0
# Optional: raise these for migrations or jobs on a large database.
# PG_LOCK_TIMEOUT=2s
# PG_STATEMENT_TIMEOUT=5s
# The header your proxy sets with the client's address, e.g. HTTP_X_REAL_IP. Empty means the socket address.
# CLIENT_IP_HEADER=
