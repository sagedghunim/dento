msgid "The username or password is wrong."
msgstr "اسم المستخدم أو كلمة المرور غير صحيحة."

#, python-format
msgid "Too many attempts. Try again in %(minutes)s minutes."
msgstr "محاولات كثيرة. حاول مرة أخرى بعد %(minutes)s دقيقة."

msgid "This temporary password has expired. Ask for a new one."
msgstr "انتهت صلاحية كلمة المرور المؤقتة. اطلب كلمة مرور جديدة."

msgid "Your sign-in expired. Sign in again."
msgstr "انتهت مهلة تسجيل الدخول. سجّل الدخول مرة أخرى."

msgid "Too many wrong codes. Sign in again."
msgstr "أكواد خاطئة كثيرة. سجّل الدخول مرة أخرى."

msgid "That code is wrong. Try the newest one."
msgstr "الكود غير صحيح. جرّب أحدث كود."

msgid "The current password is wrong."
msgstr "كلمة المرور الحالية غير صحيحة."

msgid "Two-step sign-in is already set up."
msgstr "الدخول بخطوتين مفعّل بالفعل."

msgid "Start the set-up first."
msgstr "ابدأ الإعداد أولاً."

msgid "That clinic isn't available."
msgstr "هذه العيادة غير متاحة."

msgid "Please sign in."
msgstr "من فضلك سجّل الدخول."

msgid "Pick Arabic or English."
msgstr "اختر العربية أو الإنجليزية."

msgid "Change your password to continue."
msgstr "غيّر كلمة المرور للمتابعة."

msgid "Book, reschedule and cancel"
msgstr "الحجز وتغيير الموعد والإلغاء"

msgid "Arrive, call in and finish"
msgstr "تسجيل الحضور والدخول للطبيب وإنهاء الزيارة"

msgid "Search and open patient details"
msgstr "البحث في بيانات المرضى وفتحها"

msgid "Create and edit patient files"
msgstr "إنشاء ملفات المرضى وتعديلها"

msgid "Read visit notes and prescriptions"
msgstr "قراءة ملاحظات الزيارات والروشتات"

msgid "Write visit notes and prescriptions"
msgstr "كتابة ملاحظات الزيارات والروشتات"

msgid "Take payments and add list-price lines"
msgstr "تحصيل المدفوعات وإضافة بنود بسعر القائمة"

msgid "Give discounts and prices not from the list"
msgstr "عمل خصومات وأسعار من خارج القائمة"

msgid "Refund payments and void invoices"
msgstr "رد المدفوعات وإلغاء الفواتير"

msgid "Record stock use"
msgstr "تسجيل استخدام المخزون"

msgid "Manage items, purchases and stock counts"
msgstr "إدارة الأصناف والمشتريات وجرد المخزون"

msgid "See the month's money and staff pay"
msgstr "الاطلاع على حسابات الشهر ورواتب الفريق"

msgid "Edit staff pay"
msgstr "تعديل رواتب الفريق"

msgid "Add and void expenses"
msgstr "إضافة المصروفات وإلغاؤها"

msgid "Handle online consultation requests"
msgstr "متابعة طلبات الاستشارة أونلاين"

msgid "Change the clinic profile, services, prices, schedules and medicines"
msgstr "تعديل بيانات العيادة والخدمات والأسعار والمواعيد والأدوية"

msgid "Manage members and permissions"
msgstr "إدارة الفريق والصلاحيات"

msgid "Read the change and access logs"
msgstr "قراءة سجل التغييرات وسجل الاطلاع"

msgid "Send the changes and the values they replace."
msgstr "أرسل التغييرات والقيم التي تحل محلها."

msgid "Someone changed these settings meanwhile. Reload and try again."
msgstr "غيّر شخص آخر هذه الإعدادات للتو. أعد تحميل الصفحة وحاول مرة أخرى."

msgid "The request couldn't be read."
msgstr "تعذرت قراءة الطلب."

msgid "This request needs an Idempotency-Key."
msgstr "هذا الطلب يحتاج إلى مفتاح طلب (Idempotency-Key)."

msgid "Pick a clinic first."
msgstr "اختر العيادة أولاً."

msgid "The clinic is being moved. Try again in a moment."
msgstr "جارٍ نقل بيانات العيادة. حاول مرة أخرى بعد لحظات."

msgid "This clinic is suspended."
msgstr "هذه العيادة موقوفة."

msgid "You are no longer a member of this clinic."
msgstr "لم تعد عضواً في هذه العيادة."

msgid "Set up two-step sign-in to continue."
msgstr "فعّل الدخول بخطوتين للمتابعة."

msgid "Enter the code from your authenticator app."
msgstr "أدخل الكود من تطبيق المصادقة."

msgid "This request key was already used for a different request."
msgstr "مفتاح الطلب هذا استُخدم لطلب مختلف."

msgid "Someone else is changing this. Trying again."
msgstr "شخص آخر يعدّل هذا الآن. جارٍ المحاولة مرة أخرى."

msgid "This took too long. Try again."
msgstr "استغرق الأمر وقتاً طويلاً. حاول مرة أخرى."

msgid "This method isn't allowed here."
msgstr "هذه العملية غير مسموحة هنا."

msgid "Another tab switched clinic. Reloading."
msgstr "تم تغيير العيادة في نافذة أخرى. جارٍ إعادة التحميل."

msgid "You don't have permission to do this."
msgstr "ليست لديك صلاحية للقيام بهذا."

msgid "Your session changed. Trying again."
msgstr "تغيرت جلستك. جارٍ المحاولة مرة أخرى."

msgid "Dento"
msgstr "دينتو"

msgid "Sign out"
msgstr "تسجيل الخروج"

msgid "Pick a clinic"
msgstr "اختر العيادة"

